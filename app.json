{
  "expo": {
    "name": "Instablock",
    "slug": "aceleralock",
    "scheme": "aceleralock",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": ["ios", "android"],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon-square-1024.png",
    "ios": {
      "bundleIdentifier": "com.aceleralock.app",
      "supportsTablet": false,
      "entitlements": {
        "com.apple.developer.family-controls": true,
        "com.apple.security.application-groups": ["group.com.aceleralock.app"]
      }
    },
    "android": {
      "package": "dev.marujo.appblocker",
      "versionCode": 6,
      "allowBackup": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#04141c",
        "foregroundImage": "./assets/android/adaptive/foreground-1024.png",
        "monochromeImage": "./assets/android/adaptive/monochrome-1024.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F7F8",
          "image": "./assets/icon-1024.png",
          "imageWidth": 132,
          "dark": {
            "backgroundColor": "#04141c",
            "image": "./assets/icon-1024.png"
          }
        }
      ],
      "./native/plugins/withAceleralockBlocker",
      "./native/plugins/withReleaseSigning",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "supportedLocales": {
